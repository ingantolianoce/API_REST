# Copiar a .env (ignorado por git) y completar. NUNCA subir .env ni valores reales al repositorio.
# Generar secretos:  openssl rand -base64 24   (contrasenas)   |   openssl rand -base64 32   (APP_CRYPTO_KEY)
DB_NAME=app
DB_ADMIN_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_RUNTIME_PASSWORD=

# Clave AES-256 (base64 de 32 bytes) para cifrar campos sensibles (secreto TOTP). Distinta en cada entorno.
APP_CRYPTO_KEY=

# Bootstrap del primer superadmin (solo la primera vez; luego volver a false).
# La clave de un solo uso se escribe en ./.local/bootstrap/admin-credentials.txt (permisos 0600): leerla y borrar el archivo.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_TENANT_NAME=
